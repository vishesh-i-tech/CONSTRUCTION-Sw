# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database Connection (Turso / libSQL or local SQLite file)
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# JWT Secret (minimum 32 characters in production)
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-chars-long!

# Storage Configuration
# local = saves to local filesystem for development (./uploads)
# r2 = Cloudflare R2 / S3-compatible cloud object storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads

# Cloudflare R2 Credentials (required when STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
